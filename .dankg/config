# DanKG's own root. Marks the whole repository as one corpus, so
# `dankg check` can verify the design record's own cross-references (and,
# once `src/` starts converting, links from a decision to the code that
# implements it) never go stale silently -- the actual payoff behind
# converting `architecture.org`/`project.org` to `.md` in the first place.
#
# `[lang.*]`/`[tangle.*]` sections are added here as `src/` modules
# actually convert; nothing under docs alone needs either yet.

[tangle.rust]
ext = rs
# No `glue`/`command` yet: `src/hash.md` (the first real module) is one
# flat file with no subdirectory to declare `mod` for, and its own
# regenerate step is manual (src/hash.md, *Literate source*) rather than
# wired to run `cargo build` on every tangle -- add both once a second
# module needs the directory-declaring glue `literate/layout-pilot/`
# already proved.
