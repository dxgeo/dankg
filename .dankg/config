# DanKG's own root. Marks the whole repository as one corpus, so
# `dankg check` can verify the design record's own cross-references (and,
# once `src/` starts converting, links from a decision to the code that
# implements it) never go stale silently -- the actual payoff behind
# converting `architecture.org`/`project.org` to `.md` in the first place.
#
# `[lang.*]`/`[tangle.*]` sections are added here as `src/` modules
# actually convert, or as docs prose starts citing a block's own recorded
# output instead of a hand count.

[lang.sh]
command = sh {file}

[tangle.rust]
ext = rs
# Structural only (mod.rs generation, decision 27): every existing src/
# subdirectory's mod.rs is hand-authored as its own mod.md instead (each
# carries a real module doc comment, not just a bare list), so `rust.py`
# backs off and writes nothing for any of them -- this is a safety net for
# a future directory added without one, not something the current corpus
# exercises. `rust-doclint.py` was tried too, but this corpus's own style
# always doubles a block's introducing sentence as its doc comment, so it
# flags nearly every module and adds only noise here; skipped.
glue = python3 glue/rust.py {dir}

# Used by `dankg tui`: enter on a selected node spawns this at its source
# line. Unconfigured, enter falls back to $EDITOR/$VISUAL, and reports
# so on the status line if neither is set either -- a documented gap,
# not a silent one.
[editor]
command = nvim +{line} {file}
